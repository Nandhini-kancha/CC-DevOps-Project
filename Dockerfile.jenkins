
FROM jenkins/jenkins:lts-jdk21

USER root

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    docker.io \
    curl \
    ca-certificates \
    && curl -fsSL https://dl.k8s.io/release/v1.36.1/bin/linux/amd64/kubectl \
       -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && rm -rf /var/lib/apt/lists/*

USER jenkins